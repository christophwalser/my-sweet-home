{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["msi"],
    "publisher": "My Sweet Home",
    "copyright": "Copyright (C) 2026 Christoph Walser and the My Sweet Home contributors",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/christophwalser/my-sweet-home",
    "shortDescription": "Interior design in 2D and 3D, compatible with Sweet Home 3D files",
    "category": "GraphicsAndDesign",
    "externalBin": ["binaries/msh"],
    "resources": {
      "resources/legal/": "legal/",
      "icons/sh3d-file.ico": "icons/sh3d-file.ico"
    },
    "fileAssociations": [
      {
        "ext": ["sh3d"],
        "name": "Sweet Home 3D home",
        "description": "Sweet Home 3D home",
        "role": "Editor",
        "mimeType": "application/x-sweethome3d"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "wix": {
        "fragmentPaths": ["wix/cli-path.wxs"],
        "componentRefs": ["MshCliPath", "MshFileIcon"]
      }
    }
  }
}

