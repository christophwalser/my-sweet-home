{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "*.ts", "*.json", "!src-tauri", "!dist"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    },
    "domains": { "test": "none" }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": { "domains": { "test": "recommended" } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
